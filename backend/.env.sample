PORT=3005
TOKEN_KEY=your_secret_key_here
ALLOWED_ORIGINS=http://example.com,https://myapp.com
MAX_UPLOAD_FILE_SIZE_MB=4096
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TTS_MODEL=gpt-4o-mini-tts
